{
  "name": "dsh-model-refresh",
  "displayName": "模型目录刷新（pi-ai 上游 → 路由）",
  "version": "0.8.8",
  "description": "在模型设置页从 provider 自己的 /models 端点拉取模型清单，选择后追加写入路由配置；附高级诊断与目录核对。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-model-refresh.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-model-refresh#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-model-refresh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.example.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "llm",
    "model-catalog"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "preflight:state": "node scripts/preflight-state.mjs",
    "preflight:live": "node scripts/preflight-live.mjs",
    "test": "node scripts/test-all.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
