{
  "name": "dsh-model-refresh",
  "displayName": "模型目录刷新（models.dev → pi-ai 路由）",
  "version": "0.3.0",
  "private": true,
  "description": "定时从 models.dev 拉取最新模型数据，与已安装 pi-ai catalog 合并生成 llm-pi-ai 路由 models 片段，并（经用户授权）把新模型合入安装树 catalog；带设置页（provider 开关 / 拉取监控 / 代理 / 移除过时模型）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.example.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "llm",
    "model-catalog"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "react": "^18.3.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
