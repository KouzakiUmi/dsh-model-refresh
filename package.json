{
  "name": "dsh-model-refresh",
  "displayName": "模型目录刷新（pi-ai 上游 → 路由）",
  "version": "0.8.9",
  "description": "以 refresh-* 独立 provider 提供最新 pi-ai 模型目录，复用已安装协议能力，不改原路由或安装目录。",
  "engines": { "node": ">=22.19.0", "dsh": "0.2.1-rc.3" },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.3",
    "@earendil-works/pi-ai": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-model-refresh.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-model-refresh#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-model-refresh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "docs/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "llm",
    "model-catalog"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "preflight:state": "node scripts/preflight-state.mjs",
    "preflight:live": "node scripts/preflight-live.mjs",
    "test": "node scripts/test-all.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
